# Copie este arquivo para ".env" e preencha com os dados do seu servidor.
# NUNCA suba o arquivo ".env" real para um repositório público.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gamers_arena
DB_USERNAME=root
DB_PASSWORD=

APP_URL=http://localhost:8000
APP_ENV=production

# Chaves da Stripe (obtidas em https://dashboard.stripe.com/apikeys).
# Sem elas (nem em /admin/settings.php), o checkout fica bloqueado a menos
# que o modo demonstração seja ativado manualmente em /admin/settings.php.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# Signing secret do webhook (dashboard.stripe.com/webhooks), evento
# checkout.session.completed apontando para /actions/stripe_webhook.php.
# Garante a confirmação do pedido mesmo se o comprador fechar a aba antes
# de voltar ao site. Também pode ser preenchido em /admin/settings.php.
STRIPE_WEBHOOK_SECRET=
